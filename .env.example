# Docker Compose: готовый образ из GitHub Container Registry.
APP_IMAGE=ghcr.io/nozloy/state51:main

# Runtime: задаются в Coolify, для сборки в GitHub не нужны.
YC_PARTNER_TOKEN=
YC_USER_TOKEN=
YC_COMPANY_ID=
YC_GROUP_ID=
YC_ADMIN_LOGIN=
YC_ADMIN_PASSWORD=

# Build time: GitHub Actions repository variable с таким же именем.
# После изменения нужно пересобрать образ. Пустое значение отключает Метрику.
NEXT_PUBLIC_YANDEX_METRICA_ID=
